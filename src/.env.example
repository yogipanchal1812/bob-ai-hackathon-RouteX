# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# IBM watsonx.ai (if used)
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Database (if used)
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Application
APP_PORT=8000
APP_ENV=development

# Notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Add your project-specific variables below

# ── Module 4: Fleet & Simulation (Member 4) ──────────────────────────────────
# Port for the optimization microservice (default: 8001)
OPT_PORT=8001
# Logging level for the optimization service
OPT_LOG_LEVEL=INFO
# Member 1's disruption API base URL (leave blank to use seed data in dev mode)
DISRUPTION_API_URL=
# Comma-separated allowed CORS origins (Member 2 frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
